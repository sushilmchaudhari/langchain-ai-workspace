# from langchain_huggingface import ChatHuggingFace, HuggingFaceEndpoint
from langchain_openai import ChatOpenAI
from langchain_core.output_parsers import PydanticOutputParser
from pydantic import BaseModel, Field
from langchain_core.prompts import PromptTemplate

from dotenv import load_dotenv

load_dotenv()

# llm = HuggingFaceEndpoint(
#      repo_id="google/gemma-2b-it",
#      task="text-generation",
#  )

# model = ChatHuggingFace(llm=llm)
model = ChatOpenAI(model="gpt-4o-mini", temperature=0.7)

class Character(BaseModel):
    name: str = Field(description="Name of the character")
    age: int = Field(gt=18, description="Age of the character")
    city: str = Field(description="City of the character")

pydantic_parser = PydanticOutputParser(pydantic_object=Character)

template = PromptTemplate(
    template="Give me the best character's name, age and city in the {web_series} with the following format instructions\n {format_instructions}",
    input_variables=["web_series"],
    partial_variables={"format_instructions": pydantic_parser.get_format_instructions()}
)

prompt = template.format(web_series="Game of Thrones")
print(prompt)


chain = template | model | pydantic_parser

parsed_result = chain.invoke({"web_series": "Game of Thrones"})    
print(parsed_result)
